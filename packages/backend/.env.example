# The connection string to your running database server
#
# Format: `postgresql://<user>:<password>@<host>:<port>/<database-name>`
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# The origins to be accepted by the backend server
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Your DigitalOcean API Token
DIGITALOCEAN_API_TOKEN=

# The Redis channel to queue connected clients
REDIS_CHANNEL="kodaflux:projects"

# The connection string to your Redis database
REDIS_URL="redis://localhost:6379"
