# The Gradient AI model access key used to access a provided LLM model
GRADIENT_MODEL_ACCESS_KEY=

# You DigitalOcean (DO) API Key used to provide programmatic access to
# your DO resources
DIGITALOCEAN_API_TOKEN=

# Your Github Personal Access Token (PAT) to provide programmatic access to
# allow to reading repo's
GITHUB_TOKEN=
