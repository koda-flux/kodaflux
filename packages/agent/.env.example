# Your DigitalOcean API Token as generated in your DigitalOcean control panel
DIGITALOCEAN_API_TOKEN=

# Your DigitalOcean Model Access Key as generated in the Gradient AI portal.
DIGITALOCEAN_INFERENCE_KEY=

# The model your would like the system to use
DIGITALOCEAN_INFERENCE_MODEL="openai-gpt-oss-120b"

# The name of the DigitalOcean Spaces bucket to be used to store assets & scraped sites
DIGITALOCEAN_SPACES_BUCKET_NAME="kodaflux-assets"

# The region in which the Spaces bucket should be created in
DIGITALOCEAN_SPACES_REGION="fra1"

# The Spaces enpdoint to access your DigitalOcean Spaces bucket.
#
# Usually this will be the `https://<digitalocean-spaces-region>.digitaloceanspaces.com`
# With <digitalocean-spaces-region> being the value set in `DIGITALOCEAN_SPACES_REGION`
DIGITALOCEAN_SPACES_ENDPOINT="https://fra1.digitaloceanspaces.com"

# Your DigitalOcean Spaces access credentials as received for the Spaces portal.
DIGITALOCEAN_SPACES_KEY_ID=
DIGITALOCEAN_SPACES_SECRET_KEY=

# Your Github Personal Access Token (PAT) as generated in your GitHub tokens
#
# Will be remove later as we will have GitHub OAuth to authenticate users
GITHUB_TOKEN=

# Your Firecrawl API key as generated in your Firecrawl dashboard
FIRECRAWL_API_KEY=

# The endpoint that expects the notification from the agent once
# the agent completes it's task.
COMPLETION_CALLBACK_URL="http://localhost:8000/projects/callback"
